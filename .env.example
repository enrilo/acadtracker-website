# Copy to .env and fill in. .env is git-ignored; never commit real values.
# These are read only on the server (API routes). Do NOT add NEXT_PUBLIC_ prefixes.

# ---- Zoho Meeting (required for "Book a Walkthrough") ----------------------
# OAuth client from https://api-console.zoho.in (Self Client / Server-based).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Long-lived refresh token (needs Zoho Meeting scopes for creating/listing meetings).
# Reuse your existing token. Generating new ones can revoke the oldest.
ZOHO_REFRESH_TOKEN=
# Data-center suffix: "in" for India (accounts.zoho.in / meeting.zoho.in).
ZOHO_DC=in
# Zoho Meeting organisation ID (zsoid).
ZOHO_MEETING_ZSOID=
# Host's Zoho user ID. Leave empty to look it up automatically via /user.json.
ZOHO_PRESENTER_ZUID=

# ---- Confirmation email via SMTP (optional) ---------------------------------
# Emails are skipped unless SMTP_HOST, SMTP_USER and SMTP_PASS are all set.
SMTP_HOST=
# 465 for SSL, 587 for STARTTLS.
SMTP_PORT=465
# "true" for port 465, "false" for 587. Defaults to true when the port is 465.
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "AcadTracker <hello@example.com>". Defaults to SMTP_USER.
MAIL_FROM=
# Where to send a copy of each new booking. Leave empty to skip.
BOOKING_NOTIFY_EMAIL=
# Set to "false" to turn off all booking emails even when SMTP is configured.
SEND_BOOKING_EMAIL=true
